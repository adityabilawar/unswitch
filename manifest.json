{
  "manifest_version": 3,
  "name": "Tab Lock – Focus Mode",
  "description": "Tab Lock and focus mode: lock to one tab, Pomodoro timer with escalating breaks, breathing ritual, and leave-site guard.",
  "version": "1.1.1",
  "permissions": ["tabs", "activeTab", "scripting", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/blocker.js"],
      "css": ["content/blocker.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/leave-domain.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-unlocked-16.png",
      "32": "icons/icon-unlocked-32.png",
      "48": "icons/icon-unlocked-48.png",
      "128": "icons/icon-unlocked-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-unlocked-16.png",
    "32": "icons/icon-unlocked-32.png",
    "48": "icons/icon-unlocked-48.png",
    "128": "icons/icon-unlocked-128.png"
  }
}
