# Copy to server/.env or export these in the host. Never commit real values.
# This build rejects live Stripe keys. Use test mode only.

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
LICENSE_SIGNING_SECRET=replace_with_at_least_16_random_characters
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Optional. Leave blank to send price_data from shared/pro-config.js
# ($2.99/month, $19.99/year with a 7-day trial, $29.99 lifetime).
# Set these after you create matching test prices in the Stripe Dashboard.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=

PORT=8787
